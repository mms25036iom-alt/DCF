# Server-only settings. Never prefix a secret with NEXT_PUBLIC_.
APP_ENV=development
APP_MODE=LIVE
MODEL_ROUTER_PROVIDER=none
YAHOO_CACHE_TTL_SECONDS=1800
STOCK_MODEL_TIMEOUT_SECONDS=90
# run.ps1 generates local service credentials automatically.
# For Vercel generate .private/deployment.env using scripts/generate_secrets.py.
# INTERNAL_API_TOKEN=
# SNAPSHOT_ENCRYPTION_KEY=
# APP_SESSION_SECRET=
# APP_ACCESS_PASSWORD=
# Optional narrative: none (no key), groq (your key), ollama (local only).
# GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_ID=llama3.2
MODEL_TIMEOUT_SECONDS=25
MODEL_MAX_OUTPUT_TOKENS=1500
MODEL_CONTEXT_MAX_CHARS=12000
# Local Node server only. Vercel supplies PRIVATE_API_URL service binding.
API_BASE_URL=http://127.0.0.1:8000
