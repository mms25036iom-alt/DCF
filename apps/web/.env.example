# Local FastAPI origin, without /v1. Ignored on Vercel.
API_BASE_URL=http://127.0.0.1:8000
# Vercel supplies this private service binding automatically; leave it unset there.
PRIVATE_API_URL=
# Same random secret on the Next.js and Python servers; at least 32 characters.
INTERNAL_API_TOKEN=
# Required on Vercel / APP_ENV=production: private owner password (20-512 characters).
APP_ACCESS_PASSWORD=
# Required with password access: separate random secret, at least 32 characters.
APP_SESSION_SECRET=
# Never prefix these values or data-provider keys with NEXT_PUBLIC_.
