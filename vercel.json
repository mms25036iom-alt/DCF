{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web/",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "PRIVATE_API_URL" }
      ]
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "services.serverless.app:app",
      "functions": {
        "services/serverless/app.py": {
          "maxDuration": 300,
          "excludeFiles": "{apps/**,tests/**,scripts/**,.private/**,output/**,docs/**,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
